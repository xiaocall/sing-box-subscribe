{
  "$schema": "https://sing-box.sagernet.org/schema.json",
  "log": {
    "level": "info",
    "timestamp": true
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "store_fakeip": true,
      "store_dns": true
    },
    "clash_api": {
      "external_controller": "127.0.0.1:9090",
      "external_ui": "zashboard",
      "secret": "singbox",
      "external_ui_download_url": "https://gh-proxy.com/https://github.com/Zephyruso/zashboard/archive/refs/heads/gh-pages.zip",
      "external_ui_download_detour": "Direct",
      "default_mode": "Rule"
    }
  },
  "http_clients": [
    {
      "tag": "default"
    }
  ],
  "dns": {
    "servers": [
      {
        "tag": "ali-dns",
        "type": "udp",
        "server": "223.5.5.5"
      },
      {
        "tag": "remote-dns",
        "type": "udp",
        "server": "8.8.8.8",
        "detour": "Proxy"
      },
      {
        "tag": "fakeip",
        "type": "fakeip",
        "inet4_range": "198.18.0.0/15",
        "inet6_range": "fc00::/18"
      },
      {
        "tag": "local",
        "type": "local"
      }
    ],
    "rules": [
      {
        "clash_mode": "Direct",
        "action": "route",
        "server": "local"
      },
      {
        "clash_mode": "Global",
        "action": "route",
        "server": "fakeip"
      },
      {
        "query_type": "HTTPS",
        "action": "reject"
      },
      {
        "rule_set": [
          "Reject",
          "Ads_AWAvenue"
        ],
        "action": "reject"
      },
      {
        "rule_set": [
          "AppleCN",
          "ChinaDomain"
        ],
        "action": "route",
        "server": "ali-dns"
      },
      {
        "domain_suffix": [
          "local",
          "lan",
          "home",
          "internal",
          "corp",
          "example.com"
        ],
        "server": "local"
      },
      {
        "query_type": [
          "A",
          "AAAA"
        ],
        "action": "route",
        "server": "fakeip",
        "rewrite_ttl": 1
      }
    ],
    "optimistic": true,
    "strategy": "prefer_ipv4",
    "final": "remote-dns"
  },
  "inbounds": [
    {
      "tag": "tun-in",
      "type": "tun",
      "address": [
        "172.19.0.0/30",
        "fdfe:dcba:9876::0/126"
      ],
      "stack": "mixed",
      "auto_route": true,
      "strict_route": true,
      "platform": {
        "http_proxy": {
          "enabled": true,
          "server": "127.0.0.1",
          "server_port": 7890
        }
      }
    },
    {
      "tag": "mixed-in",
      "type": "mixed",
      "listen": "127.0.0.1",
      "listen_port": 7890
    }
  ],
  "outbounds": [
    {
      "tag": "Direct",
      "type": "direct"
    },
    {
      "tag": "Proxy",
      "type": "selector",
      "outbounds": [
        "Auto",
        "手动选择",
        "Direct"
      ],
      "default": "Auto",
      "interrupt_exist_connections": true
    },
    {
      "tag": "手动选择",
      "type": "selector",
      "outbounds": [
        "Direct",
        "{all}"
      ],
      "default": "Direct",
      "interrupt_exist_connections": true
    },
    {
      "tag": "漏网之鱼",
      "type": "selector",
      "outbounds": [
        "Proxy",
        "手动选择",
        "Direct",
        "Auto",
        "{all}"
      ],
      "default": "Proxy",
      "interrupt_exist_connections": true
    },
    {
      "tag": "Auto",
      "type": "urltest",
      "outbounds": [
        "{all}"
      ],
      "url": "http://www.gstatic.com/generate_204",
      "interval": "10m",
      "tolerance": 50
    },
    {
      "tag": "AI",
      "type": "selector",
      "outbounds": [
        "Proxy",
        "手动选择",
        "Auto",
        "Direct",
        "{all}"
      ],
      "default": "Proxy",
      "interrupt_exist_connections": true
    },
    {
      "tag": "Google",
      "type": "selector",
      "outbounds": [
        "Proxy",
        "手动选择",
        "Auto",
        "Direct",
        "{all}"
      ],
      "default": "Proxy",
      "interrupt_exist_connections": true
    },
    {
      "tag": "Microsoft",
      "type": "selector",
      "outbounds": [
        "Direct",
        "Proxy",
        "手动选择",
        "Auto",
        "{all}"
      ],
      "default": "Direct",
      "interrupt_exist_connections": true
    },
    {
      "tag": "Social",
      "type": "selector",
      "outbounds": [
        "Proxy",
        "手动选择",
        "Auto",
        "Direct",
        "{all}"
      ],
      "default": "Proxy",
      "interrupt_exist_connections": true
    },
    {
      "tag": "TikTok",
      "type": "selector",
      "outbounds": [
        "Proxy",
        "手动选择",
        "Auto",
        "Direct",
        "{all}"
      ],
      "default": "Proxy",
      "interrupt_exist_connections": true
    },
    {
      "tag": "Telegram",
      "type": "selector",
      "outbounds": [
        "Proxy",
        "手动选择",
        "Auto",
        "Direct",
        "{all}"
      ],
      "default": "Proxy",
      "interrupt_exist_connections": true
    },
    {
      "tag": "Game",
      "type": "selector",
      "outbounds": [
        "Direct",
        "Proxy",
        "手动选择",
        "Auto",
        "{all}"
      ],
      "default": "Direct",
      "interrupt_exist_connections": true
    },
    {
      "tag": "Emby",
      "type": "selector",
      "outbounds": [
        "Proxy",
        "手动选择",
        "Auto",
        "Direct",
        "{all}"
      ],
      "default": "Proxy",
      "interrupt_exist_connections": true
    },
    {
      "tag": "Spotify",
      "type": "selector",
      "outbounds": [
        "Proxy",
        "手动选择",
        "Auto",
        "Direct",
        "{all}"
      ],
      "default": "Proxy",
      "interrupt_exist_connections": true
    },
    {
      "tag": "Streaming",
      "type": "selector",
      "outbounds": [
        "Proxy",
        "手动选择",
        "Auto",
        "Direct",
        "{all}"
      ],
      "default": "Proxy",
      "interrupt_exist_connections": true
    },
    {
      "tag": "BiliBili",
      "type": "selector",
      "outbounds": [
        "Direct",
        "Proxy",
        "手动选择",
        "{all}"
      ],
      "default": "Direct",
      "interrupt_exist_connections": true
    }
  ],
  "route": {
    "default_domain_resolver": "ali-dns",
    "default_http_client": "default",
    "auto_detect_interface": true,
    "find_process": true,
    "final": "漏网之鱼",
    "rules": [
      {
        "action": "sniff"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "port": 53
          },
          {
            "protocol": "dns"
          }
        ],
        "action": "hijack-dns"
      },
      {
        "clash_mode": "Direct",
        "action": "route",
        "outbound": "Direct"
      },
      {
        "clash_mode": "Global",
        "action": "route",
        "outbound": "Proxy"
      },
      {
        "rule_set": [
          "Reject",
          "Ads_AWAvenue"
        ],
        "action": "reject"
      },
      {
        "rule_set": [
          "AppleCN"
        ],
        "action": "route",
        "outbound": "Direct"
      },
      {
        "rule_set": [
          "AI"
        ],
        "action": "route",
        "outbound": "AI"
      },
      {
        "rule_set": [
          "Telegram"
        ],
        "action": "route",
        "outbound": "Telegram"
      },
      {
        "rule_set": [
          "Twitter",
          "Facebook"
        ],
        "action": "route",
        "outbound": "Social"
      },
      {
        "rule_set": [
          "TikTok"
        ],
        "action": "route",
        "outbound": "TikTok"
      },
      {
        "rule_set": [
          "Steam",
          "Epic"
        ],
        "action": "route",
        "outbound": "Game"
      },
      {
        "rule_set": [
          "Google",
          "YouTube",
          "Github"
        ],
        "action": "route",
        "outbound": "Google"
      },
      {
        "rule_set": [
          "Microsoft"
        ],
        "action": "route",
        "outbound": "Microsoft"
      },
      {
        "rule_set": [
          "Emby"
        ],
        "action": "route",
        "outbound": "Emby"
      },
      {
        "rule_set": [
          "Spotify"
        ],
        "action": "route",
        "outbound": "Spotify"
      },
      {
        "rule_set": [
          "Bilibili"
        ],
        "action": "route",
        "outbound": "BiliBili"
      },
      {
        "rule_set": [
          "Bahamut",
          "Netflix",
          "Disney",
          "PrimeVideo",
          "HBO"
        ],
        "action": "route",
        "outbound": "Streaming"
      },
      {
        "rule_set": [
          "ChinaDomain"
        ],
        "action": "route",
        "outbound": "Direct"
      },
      {
        "rule_set": [
          "Proxy"
        ],
        "action": "route",
        "outbound": "Proxy"
      },
      {
        "rule_set": [
          "AppleProxy"
        ],
        "action": "route",
        "outbound": "Proxy"
      },
      {
        "action": "resolve"
      },
      {
        "rule_set": [
          "ChinaIP"
        ],
        "action": "route",
        "outbound": "Direct"
      },
      {
        "ip_is_private": true,
        "action": "route",
        "outbound": "Direct"
      }
    ],
    "rule_set": [
      {
        "type": "remote",
        "tag": [
          "Reject",
          "Ads_AWAvenue",
          "Proxy",
          "AI",
          "Telegram",
          "Twitter",
          "Facebook",
          "TikTok",
          "Steam",
          "Epic",
          "Google",
          "YouTube",
          "Github",
          "Microsoft",
          "Bilibili",
          "Bahamut",
          "Emby",
          "Spotify",
          "Netflix",
          "Disney",
          "PrimeVideo",
          "HBO",
          "AppleCN",
          "AppleProxy",
          "ChinaDomain",
          "ChinaIP"
        ],
        "format": "binary",
        "url": "https://gh-proxy.com/https://raw.githubusercontent.com/Repcz/Tool/X/sing-box/Rules/{tag}.srs",
        "update_interval": "24h"
      }
    ]
  }
}
