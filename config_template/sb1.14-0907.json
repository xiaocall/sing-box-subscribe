                "download_detour": "节点选择"
            },
            {
                "tag": "geoip-netflix",
                "type": "remote",
                "format": "binary",
                "url": "https://cdn.jsdmirror.com/gh/perfect-panel/rules/geo/geoip/netflix.srs",
                "download_detour": "节点选择"
            },
            {
                "tag": "geosite-netflix",
                "type": "remote",
                "format": "binary",
                "url": "https://cdn.jsdmirror.com/gh/perfect-panel/rules/geo/geosite/netflix.srs",
                "download_detour": "节点选择"
            },
            {
                "tag": "geosite-disney",
                "type": "remote",
                "format": "binary",
                "url": "https://cdn.jsdmirror.com/gh/perfect-panel/rules/geo/geosite/disney.srs",
                "download_detour": "节点选择"
            },
            {
                "tag": "geosite-spotify",
                "type": "remote",
                "format": "binary",
