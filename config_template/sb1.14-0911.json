{
    "$schema": "https://sing-box.sagernet.org/schema.json",
    "log":
    {
        "level": "info",
        "timestamp": true
    },
    "experimental":
    {
        "cache_file":
        {
            "enabled": true,
            "store_fakeip": true,
            "store_dns": true
        }
    },
    "dns":
    {
        "servers":
        [
            {
                "tag": "direct_dns",
                "type": "https",
                "server": "https://dns.alidns.com/dns-query"
            },
            {
                "tag": "proxy_dns",
                "type": "https",
                "server": "https://cloudflare-dns.com/dns-query",
                "detour": "Default"
            }
        ],
        "rules":
        [
            {
                "rule_set":
                [
                    "cnsite"
                ],
                "server": "direct_dns"
            },
            {
                "rule_set":
                [
                    "gfw",
                    "aiservice",
                    "netflixsite",
                    "telegramsite",
                    "google"
                ],
                "server": "proxy_dns"
            },
            {
                "domain_suffix":
                [
                    ".cn"
                ],
                "server": "direct_dns"
            }
        ],
        "final": "proxy_dns",
        "strategy": "ipv4_only",
        "reverse_mapping": true,
        "timeout": "10s"
    },
    "inbounds":
    [
        {
            "type": "tun",
            "tag": "tun-in",
            "address":
            [
                "172.18.0.1/30"
            ],
            "mtu": 1500,
            "auto_route": true,
            "strict_route": true,
            "stack": "mixed",
            "endpoint_independent_nat": false,
            "dns_mode": "hijack"
        }
    ],
    "outbounds":
    [
        {
            "type": "selector",
            "tag": "Default",
            "interrupt_exist_connections": true,
            "outbounds":
            [
                "Auto",
                "{all}"
            ]
        },
        {
            "type": "urltest",
            "tag": "Auto",
            "outbounds":
            [
                "{all}"
            ],
            "interval": "5m",
            "tolerance": 50,
            "url": "https://cp.cloudflare.com/generate_204"
        },
        {
            "type": "urltest",
            "tag": "Auto-HK",
            "outbounds":
            [
                "{all}"
            ],
            "filter": "(?i)(香港|HK|Hong Kong|🇭🇰)",
            "interval": "5m",
            "tolerance": 50,
            "url": "https://cp.cloudflare.com/generate_204"
        },
        {
            "type": "urltest",
            "tag": "Auto-JP",
            "outbounds":
            [
                "{all}"
            ],
            "filter": "(?i)(日本|JP|Japan|🇯🇵)",
            "interval": "5m",
            "tolerance": 50,
            "url": "https://cp.cloudflare.com/generate_204"
        },
        {
            "type": "urltest",
            "tag": "Auto-US",
            "outbounds":
            [
                "{all}"
            ],
            "filter": "(?i)(美国|US|United States|America|🇺🇸)",
            "interval": "5m",
            "tolerance": 50,
            "url": "https://cp.cloudflare.com/generate_204"
        },
        {
            "type": "urltest",
            "tag": "Auto-SG",
            "outbounds":
            [
                "{all}"
            ],
            "filter": "(?i)(新加坡|SG|Singapore|🇸🇬)",
            "interval": "5m",
            "tolerance": 50,
            "url": "https://cp.cloudflare.com/generate_204"
        },
        {
            "type": "selector",
            "tag": "AI-Service",
            "outbounds":
            [
                "Default",
                "Auto"
            ]
        },
        {
            "type": "selector",
            "tag": "Streaming",
            "outbounds":
            [
                "Default",
                "Auto"
            ]
        },
        {
            "type": "selector",
            "tag": "Telegram",
            "outbounds":
            [
                "Default",
                "Auto"
            ]
        },
        {
            "type": "selector",
            "tag": "Google",
            "outbounds":
            [
                "Default",
                "Auto"
            ]
        },
        {
            "type": "selector",
            "tag": "TikTok",
            "outbounds":
            [
                "Default",
                "Auto"
            ]
        },
        {
            "type": "direct",
            "tag": "Direct-Out",
            "domain_resolver": "direct_dns"
        }
    ],
    "route":
    {
        "final": "Default",
        "auto_detect_interface": true,
        "rules":
        [
            {
                "action": "sniff",
                "sniffer":
                [
                    "http",
                    "tls",
                    "quic",
                    "dns",
                    "bittorrent"
                ],
                "timeout": "500ms"
            },
            {
                "type": "logical",
                "mode": "or",
                "rules":
                [
                    {
                        "protocol": "dns"
                    },
                    {
                        "port": 53
                    }
                ],
                "action": "hijack-dns"
            },
            {
                "ip_is_private": true,
                "outbound": "Direct-Out"
            },
            {
                "clash_mode": "direct",
                "outbound": "Direct-Out"
            },
            {
                "clash_mode": "global",
                "outbound": "Default"
            },
            {
                "rule_set": "adobe_reject",
                "action": "reject"
            },
            {
                "rule_set": "cnip",
                "outbound": "Direct-Out"
            },
            {
                "rule_set": "cnsite",
                "outbound": "Direct-Out"
            },
            {
                "rule_set":
                [
                    "aiservice"
                ],
                "outbound": "AI-Service"
            },
            {
                "rule_set":
                [
                    "netflixsite",
                    "netflixip",
                    "disney",
                    "hbo",
                    "hulu"
                ],
                "outbound": "Streaming"
            },
            {
                "rule_set":
                [
                    "telegramsite",
                    "telegramip"
                ],
                "outbound": "Telegram"
            },
            {
                "rule_set":
                [
                    "googlesite",
                    "google"
                ],
                "outbound": "Google"
            },
            {
                "rule_set": "tiktok",
                "outbound": "TikTok"
            },
            {
                "rule_set": "gfw",
                "outbound": "Default"
            }
        ],
        "rule_set":
        [
            {
                "tag": "cnsite",
                "type": "remote",
                "format": "binary",
                "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/cn.srs",
                "download_detour": "Direct-Out",
                "update_interval": "24h"
            },
            {
                "tag": "cnip",
                "type": "remote",
                "format": "binary",
                "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geoip/cn.srs",
                "download_detour": "Direct-Out",
                "update_interval": "24h"
            },
            {
                "tag": "gfw",
                "type": "remote",
                "format": "binary",
                "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/gfw.srs",
                "download_detour": "Direct-Out",
                "update_interval": "24h"
            },
            {
                "tag": "aiservice",
                "type": "remote",
                "format": "binary",
                "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/category-ai-!cn.srs",
                "download_detour": "Direct-Out",
                "update_interval": "24h"
            },
            {
                "tag": "telegramsite",
                "type": "remote",
                "format": "binary",
                "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/telegram.srs",
                "download_detour": "Direct-Out",
                "update_interval": "24h"
            },
            {
                "tag": "telegramip",
                "type": "remote",
                "format": "binary",
                "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geoip/telegram.srs",
                "download_detour": "Direct-Out",
                "update_interval": "24h"
            },
            {
                "tag": "netflixsite",
                "type": "remote",
                "format": "binary",
                "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/netflix.srs",
                "download_detour": "Direct-Out",
                "update_interval": "24h"
            },
            {
                "tag": "netflixip",
                "type": "remote",
                "format": "binary",
                "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geoip/netflix.srs",
                "download_detour": "Direct-Out",
                "update_interval": "24h"
            },
            {
                "tag": "disney",
                "type": "remote",
                "format": "binary",
                "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/disney.srs",
                "download_detour": "Direct-Out",
                "update_interval": "24h"
            },
            {
                "tag": "hbo",
                "type": "remote",
                "format": "binary",
                "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/hbo.srs",
                "download_detour": "Direct-Out",
                "update_interval": "24h"
            },
            {
                "tag": "hulu",
                "type": "remote",
                "format": "binary",
                "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/hulu.srs",
                "download_detour": "Direct-Out",
                "update_interval": "24h"
            },
            {
                "tag": "googlesite",
                "type": "remote",
                "format": "binary",
                "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/google.srs",
                "download_detour": "Direct-Out",
                "update_interval": "24h"
            },
            {
                "tag": "google",
                "type": "remote",
                "format": "binary",
                "url": "https://cdn.jsdelivr.net/gh/senshinya/singbox_ruleset@main/rule/Google/Google.srs",
                "download_detour": "Direct-Out",
                "update_interval": "24h"
            },
            {
                "tag": "tiktok",
                "type": "remote",
                "format": "binary",
                "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/tiktok.srs",
                "download_detour": "Direct-Out",
                "update_interval": "24h"
            },
            {
                "tag": "adobe_reject",
                "type": "inline",
                "rules":
                [
                    {
                        "domain":
                        [
                            "crs.cr.adobe.com",
                            "prod.adobegenuine.com"
                        ],
                        "domain_suffix":
                        [
                            "adobestats.io",
                            "adobe.io",
                            "hstatic.io"
                        ]
                    }
                ]
            }
        ]
    }
}
