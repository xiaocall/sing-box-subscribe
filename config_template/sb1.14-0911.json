{
  "$schema": "https://sing-box.sagernet.org/schema.json",
  "experimental": {
    "cache_file": {
      "enabled": true,
      "store_dns": true
    }
  },
  "log": {
    "level": "info",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "tag": "cn_bootstrap",
        "type": "udp",
        "server": "223.5.5.5",
        "server_port": 53
      },
      {
        "tag": "cn_dns",
        "type": "tls",
        "server": "223.5.5.5",
        "server_port": 853
      },
      {
        "tag": "proxy_dns",
        "type": "tls",
        "server": "1.1.1.1",
        "server_port": 853,
        "detour": "Default"
      }
    ],
    "rules": [
      {
        "rule_set": "adobe_reject",
        "action": "reject",
        "method": "default"
      },
      {
        "clash_mode": "direct",
        "server": "cn_dns"
      },
      {
        "clash_mode": "global",
        "server": "proxy_dns"
      },
      {
        "domain_suffix": [
          "ottiptv.cc"
        ],
        "server": "cn_dns"
      },
      {
        "rule_set": [
          "cnsite",
          "cngames"
        ],
        "server": "cn_dns"
      },
      {
        "domain_suffix": [
          ".cn"
        ],
        "server": "cn_dns"
      },
      {
        "rule_set": [
          "gfw",
          "googlesite",
          "telegramsite",
          "netflixsite",
          "aiservice"
        ],
        "server": "proxy_dns"
      }
    ],
    "final": "proxy_dns",
    "strategy": "ipv4_only",
    "reverse_mapping": true
  },
  "http_clients": [
    {
      "tag": "rule-set-direct",
      "version": 2,
      "domain_resolver": "cn_bootstrap"
    }
  ],
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "address": [
        "172.18.0.1/30"
      ],
      "mtu": 1500,
      "auto_route": true,
      "route_exclude_address": [
        "10.0.0.0/8",
        "100.64.0.0/10",
        "169.254.0.0/16",
        "172.16.0.0/12",
        "192.0.0.0/24",
        "192.168.0.0/16",
        "fc00::/7",
        "fe80::/10"
      ],
      "endpoint_independent_nat": false,
      "stack": "mixed",
      "dns_mode": "hijack"
    }
  ],
  "outbounds": [
    {
      "type": "selector",
      "tag": "Default",
      "outbounds": [
        "Auto",
        "Direct-Out",
        "{all}"
      ]
    },
    {
      "type": "urltest",
      "tag": "Auto",
      "outbounds": [
        "{all}"
      ],
      "url": "https://cp.cloudflare.com/generate_204",
      "interval": "3m",
      "tolerance": 50
    },
    {
      "type": "selector",
      "tag": "AI-Service",
      "outbounds": [
        "Default",
        "Auto",
        "{all}"
      ]
    },
    {
      "type": "selector",
      "tag": "Streaming-Media",
      "outbounds": [
        "Default",
        "Auto",
        "{all}"
      ]
    },
    {
      "type": "selector",
      "tag": "Telegram",
      "outbounds": [
        "Default",
        "Auto",
        "{all}"
      ]
    },
    {
      "type": "direct",
      "tag": "Direct-Out",
      "domain_resolver": "cn_dns"
    }
  ],
  "route": {
    "final": "Default",
    "auto_detect_interface": true,
    "default_http_client": "rule-set-direct",
    "default_domain_resolver": "cn_dns",
    "rules": [
      {
        "action": "sniff",
        "sniffer": [
          "http",
          "tls",
          "quic",
          "dns"
        ],
        "timeout": "300ms"
      },
      {
        "port": 53,
        "action": "hijack-dns"
      },
      {
        "network": "icmp",
        "outbound": "Direct-Out"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "network": "udp",
            "port": 443
          },
          {
            "rule_set": [
              "cnsite",
              "cnip"
            ],
            "invert": true
          }
        ],
        "action": "reject"
      },
      {
        "ip_is_private": true,
        "outbound": "Direct-Out"
      },
      {
        "clash_mode": "direct",
        "outbound": "Direct-Out"
      },
      {
        "clash_mode": "global",
        "outbound": "Default"
      },
      {
        "rule_set": "adobe_reject",
        "action": "reject"
      },
      {
        "domain_suffix": [
          "ottiptv.cc"
        ],
        "outbound": "Direct-Out"
      },
      {
        "rule_set": "aiservice",
        "outbound": "AI-Service"
      },
      {
        "rule_set": [
          "netflixsite",
          "hbo",
          "disney",
          "hulu"
        ],
        "outbound": "Streaming-Media"
      },
      {
        "rule_set": "telegramsite",
        "outbound": "Telegram"
      },
      {
        "rule_set": [
          "googlesite",
          "gfw"
        ],
        "outbound": "Default"
      },
      {
        "rule_set": [
          "cnsite",
          "cngames"
        ],
        "outbound": "Direct-Out"
      },
      {
        "action": "resolve"
      },
      {
        "rule_set": "telegramip",
        "outbound": "Telegram"
      },
      {
        "rule_set": "cnip",
        "outbound": "Direct-Out"
      }
    ],
    "rule_set": [
      {
        "tag": "cnsite",
        "type": "remote",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/cn.srs",
        "update_interval": "24h"
      },
      {
        "tag": "cnip",
        "type": "remote",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geoip/cn.srs",
        "update_interval": "24h"
      },
      {
        "tag": "cngames",
        "type": "remote",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/category-games-!cn@cn.srs",
        "update_interval": "24h"
      },
      {
        "tag": "gfw",
        "type": "remote",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/gfw.srs",
        "update_interval": "24h"
      },
      {
        "tag": "aiservice",
        "type": "remote",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/category-ai-!cn.srs",
        "update_interval": "24h"
      },
      {
        "tag": "telegramsite",
        "type": "remote",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/telegram.srs",
        "update_interval": "24h"
      },
      {
        "tag": "telegramip",
        "type": "remote",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geoip/telegram.srs",
        "update_interval": "24h"
      },
      {
        "tag": "netflixsite",
        "type": "remote",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/netflix.srs",
        "update_interval": "24h"
      },
      {
        "tag": "disney",
        "type": "remote",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/disney.srs",
        "update_interval": "24h"
      },
      {
        "tag": "hbo",
        "type": "remote",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/hbo.srs",
        "update_interval": "24h"
      },
      {
        "tag": "hulu",
        "type": "remote",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/hulu.srs",
        "update_interval": "24h"
      },
      {
        "tag": "googlesite",
        "type": "remote",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/google.srs",
        "update_interval": "24h"
      },
      {
        "tag": "adobe_reject",
        "type": "inline",
        "rules": [
          {
            "domain": [
              "crs.cr.adobe.com",
              "prod.adobegenuine.com"
            ],
            "domain_suffix": [
              "adobestats.io",
              "adobe.io",
              "hstatic.io"
            ]
          }
        ]
      }
    ]
  }
}
