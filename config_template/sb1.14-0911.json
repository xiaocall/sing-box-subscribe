{
  "$schema": "https://sing-box.sagernet.org/schema.json",
  "experimental": {
    "cache_file": {
      "enabled": true,
      "store_dns": true
    },
    "clash_api": {
      "external_controller": "127.0.0.1:9090",
      "external_ui": "ui",
      "secret": "",
      "external_ui_download_url": "https://gh-proxy.com/https://github.com/MetaCubeX/metacubexd/archive/refs/heads/gh-pages.zip",
      "external_ui_download_detour": "Direct-Out",
      "default_mode": "rule"
    }
  },
  "log": {
    "level": "info",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "tag": "cn_dns",
        "type": "udp",
        "server": "223.5.5.5",
        "server_port": 53
      },
      {
        "tag": "proxy_dns",
        "type": "tcp",
        "server": "8.8.8.8",
        "server_port": 53,
        "detour": "Proxy"
      }
    ],
    "rules": [
      {
        "rule_set": "adobe_reject",
        "action": "reject",
        "method": "default"
      },
      {
        "clash_mode": "direct",
        "action": "route",
        "server": "cn_dns"
      },
      {
        "clash_mode": "global",
        "action": "route",
        "server": "proxy_dns"
      },
      {
        "domain_suffix": [
          "ottiptv.cc"
        ],
        "action": "route",
        "server": "cn_dns"
      },
      {
        "rule_set": "cngames",
        "action": "route",
        "server": "cn_dns"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "domain_suffix": [
              ".cn"
            ]
          },
          {
            "rule_set": "cnsite"
          }
        ],
        "action": "route",
        "server": "cn_dns"
      },
      {
        "rule_set": "gfw",
        "action": "route",
        "server": "proxy_dns"
      }
    ],
    "final": "proxy_dns",
    "strategy": "ipv4_only",
    "reverse_mapping": true,
    "optimistic": {
      "enabled": true,
      "timeout": "3d"
    },
    "timeout": "5s"
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "address": [
        "172.18.0.1/30"
      ],
      "mtu": 1500,
      "auto_route": true,
      "endpoint_independent_nat": true,
      "stack": "mixed"
    }
  ],
  "outbounds": [
    {
      "type": "selector",
      "tag": "Proxy",
      "interrupt_exist_connections": true,
      "outbounds": [
        "Auto",
        "{all}",
        "Direct-Out"
      ]
    },
    {
      "type": "urltest",
      "tag": "Auto",
      "outbounds": [
        "{all}"
      ],
      "interval": "3m",
      "tolerance": 50,
      "url": "http://www.gstatic.com/generate_204"
    },
    {
      "type": "selector",
      "tag": "Final",
      "interrupt_exist_connections": true,
      "outbounds": [
        "Proxy",
        "Auto",
        "Direct-Out"
      ]
    },
    {
      "type": "selector",
      "tag": "AI-Service",
      "interrupt_exist_connections": true,
      "outbounds": [
        "Proxy",
        "Auto"
      ]
    },
    {
      "type": "selector",
      "tag": "TikTok",
      "interrupt_exist_connections": true,
      "outbounds": [
        "Proxy",
        "Auto"
      ]
    },
    {
      "type": "selector",
      "tag": "Streaming-Media",
      "interrupt_exist_connections": true,
      "outbounds": [
        "Proxy",
        "Auto"
      ]
    },
    {
      "type": "selector",
      "tag": "Telegram",
      "interrupt_exist_connections": true,
      "outbounds": [
        "Proxy",
        "Auto"
      ]
    },
    {
      "type": "selector",
      "tag": "Instagram",
      "interrupt_exist_connections": true,
      "outbounds": [
        "Proxy",
        "Auto"
      ]
    },
    {
      "type": "selector",
      "tag": "Google",
      "interrupt_exist_connections": true,
      "outbounds": [
        "Proxy",
        "Auto"
      ]
    },
    {
      "type": "selector",
      "tag": "PayPal",
      "interrupt_exist_connections": true,
      "outbounds": [
        "Proxy",
        "Auto",
        "Direct-Out"
      ]
    },
    {
      "type": "selector",
      "tag": "BiliBili",
      "interrupt_exist_connections": true,
      "outbounds": [
        "Direct-Out",
        "Proxy"
      ]
    },
    {
      "type": "direct",
      "tag": "Direct-Out"
    }
  ],
  "route": {
    "final": "Final",
    "auto_detect_interface": true,
    "default_domain_resolver": "cn_dns",
    "rules": [
      {
        "action": "sniff",
        "sniffer": [
          "http",
          "tls",
          "quic",
          "dns"
        ],
        "timeout": "300ms"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "protocol": "dns"
          },
          {
            "port": 53
          }
        ],
        "action": "hijack-dns"
      },
      {
        "network": "icmp",
        "outbound": "Direct-Out"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "network": "udp",
            "port": 443
          },
          {
            "protocol": "quic"
          }
        ],
        "action": "resolve"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "type": "logical",
            "mode": "or",
            "rules": [
              {
                "network": "udp",
                "port": 443
              },
              {
                "protocol": "quic"
              }
            ]
          },
          {
            "rule_set": [
              "cnsite",
              "cnip"
            ],
            "invert": true
          }
        ],
        "action": "reject"
      },
      {
        "ip_is_private": true,
        "outbound": "Direct-Out"
      },
      {
        "clash_mode": "direct",
        "outbound": "Direct-Out"
      },
      {
        "clash_mode": "global",
        "outbound": "Proxy"
      },
      {
        "rule_set": "adobe_reject",
        "action": "reject"
      },
      {
        "protocol": "bittorrent",
        "outbound": "Direct-Out"
      },
      {
        "port": [
          5201
        ],
        "outbound": "Direct-Out"
      },
      {
        "domain_suffix": [
          "ottiptv.cc"
        ],
        "outbound": "Direct-Out"
      },
      {
        "rule_set": "paypal",
        "outbound": "PayPal"
      },
      {
        "rule_set": "telegramsite",
        "outbound": "Telegram"
      },
      {
        "rule_set": "tiktok",
        "outbound": "TikTok"
      },
      {
        "rule_set": "instagram",
        "outbound": "Instagram"
      },
      {
        "rule_set": "aiservice",
        "outbound": "AI-Service"
      },
      {
        "rule_set": [
          "netflixsite",
          "hbo",
          "disney",
          "hulu"
        ],
        "outbound": "Streaming-Media"
      },
      {
        "rule_set": "bilibili",
        "outbound": "BiliBili"
      },
      {
        "rule_set": "google",
        "outbound": "Google"
      },
      {
        "rule_set": "cngames",
        "outbound": "Direct-Out"
      },
      {
        "rule_set": "gfw",
        "outbound": "Proxy"
      },
      {
        "action": "resolve"
      },
      {
        "rule_set": "telegramip",
        "outbound": "Telegram"
      },
      {
        "rule_set": "netflixip",
        "outbound": "Streaming-Media"
      },
      {
        "rule_set": "cnip",
        "outbound": "Direct-Out"
      }
    ],
    "rule_set": [
      {
        "type": "remote",
        "tag": "cnsite",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/cn.srs",
        "update_interval": "24h"
      },
      {
        "tag": "cnip",
        "type": "remote",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geoip/cn.srs",
        "update_interval": "24h"
      },
      {
        "tag": "cngames",
        "type": "remote",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/category-games-!cn@cn.srs",
        "update_interval": "24h"
      },
      {
        "tag": "gfw",
        "type": "remote",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/gfw.srs",
        "update_interval": "24h"
      },
      {
        "tag": "aiservice",
        "type": "remote",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/category-ai-!cn.srs",
        "update_interval": "24h"
      },
      {
        "tag": "paypal",
        "type": "remote",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/paypal.srs",
        "update_interval": "24h"
      },
      {
        "tag": "tiktok",
        "type": "remote",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/tiktok.srs",
        "update_interval": "24h"
      },
      {
        "tag": "instagram",
        "type": "remote",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/instagram.srs",
        "update_interval": "24h"
      },
      {
        "tag": "telegramip",
        "type": "remote",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geoip/telegram.srs",
        "update_interval": "24h"
      },
      {
        "tag": "telegramsite",
        "type": "remote",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/telegram.srs",
        "update_interval": "24h"
      },
      {
        "tag": "netflixsite",
        "type": "remote",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/netflix.srs",
        "update_interval": "24h"
      },
      {
        "tag": "netflixip",
        "type": "remote",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geoip/netflix.srs",
        "update_interval": "24h"
      },
      {
        "tag": "disney",
        "type": "remote",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/disney.srs",
        "update_interval": "24h"
      },
      {
        "tag": "hbo",
        "type": "remote",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/hbo.srs",
        "update_interval": "24h"
      },
      {
        "tag": "hulu",
        "type": "remote",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/hulu.srs",
        "update_interval": "24h"
      },
      {
        "tag": "bilibili",
        "type": "remote",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/bilibili.srs",
        "update_interval": "24h"
      },
      {
        "tag": "google",
        "type": "remote",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/senshinya/singbox_ruleset@main/rule/Google/Google.srs",
        "update_interval": "24h"
      },
      {
        "tag": "adobe_reject",
        "type": "inline",
        "rules": [
          {
            "domain": [
              "crs.cr.adobe.com",
              "prod.adobegenuine.com"
            ],
            "domain_suffix": [
              "adobestats.io",
              "adobe.io",
              "hstatic.io"
            ]
          }
        ]
      }
    ]
  }
}
